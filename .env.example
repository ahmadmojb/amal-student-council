# ─────────────────────────────────────────────────────────────
# Amal Student Council — environment configuration
# Copy to .env for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# demo        → local JSON store in .data/ (this machine only, clearly labelled)
# production  → Firebase Realtime Database (required when NODE_ENV=production)
DATA_MODE=demo

# Administrator secret (shared PIN / password). Required in production (min 10 chars).
# In demo mode an empty value falls back to the demo PIN "demo-1234".
ADMIN_PIN=
# Random string, at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
SESSION_SECRET=
# Admin session lifetime in minutes (5–1440). Default 240.
SESSION_TTL_MINUTES=240

# Public origin of the site, e.g. https://council.example.org (used for CSRF checks and certificate QR links).
PUBLIC_SITE_URL=
# Set true when running behind a reverse proxy / load balancer (always on in production).
TRUST_PROXY=false

# ── Firebase project mjlis-26-27 (production mode) ──
# Server-side Firebase (Admin SDK). Credentials, in order of preference:
#   FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY   (recommended on Netlify — fits the 4 KB function env limit)
#   FIREBASE_SERVICE_ACCOUNT_JSON                  (whole key JSON, raw or base64)
#   Application Default Credentials               (Cloud Run / `gcloud auth application-default login`)
# These are SECRETS: never commit them, never prefix them with VITE_/PUBLIC_.
FIREBASE_PROJECT_ID=mjlis-26-27
FIREBASE_DATABASE_URL=https://mjlis-26-27-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=mjlis-26-27.firebasestorage.app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web App (public client config, not secret — served to browsers at runtime by /api/config).
# VITE_FIREBASE_* and PUBLIC_FIREBASE_* names are both accepted. Restrict the API key to your domain in
# Google Cloud Console; access control is enforced by database.rules.json / storage.rules.
VITE_FIREBASE_API_KEY=AIzaSyDN9mAV7ImnPmSHWeHf5iyHHqV2P5m-Js
VITE_FIREBASE_AUTH_DOMAIN=mjlis-26-27.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mjlis-26-27
VITE_FIREBASE_DATABASE_URL=https://mjlis-26-27-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=mjlis-26-27.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=786348734775
VITE_FIREBASE_APP_ID=1:786348734775:web:e154be65461ee9c37a02b2
VITE_FIREBASE_MEASUREMENT_ID=G-PKKWM1CDP7

# ── Daily schedule video (docs/schedule-video.md) ──
# Maximum upload size in MB (default 250)
SCHEDULE_VIDEO_MAX_MB=250
# Bearer secret for POST /api/cron/schedule-video-cleanup (optional external scheduler / manual run). 32+ chars. Empty = endpoint disabled.
# On Netlify the scheduled function netlify/functions/schedule-video-cleanup.ts does the clean-up without it.
CRON_SECRET=

# Demo-mode data directory (default .data)
DEMO_DATA_DIR=
