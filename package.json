{
  "name": "amal-student-council",
  "version": "1.0.0",
  "private": true,
  "description": "الموقع الرسمي والبوابة العملية لمجلس الطلاب — المدرسة الثانوية الشاملة عمال يوسف شاهين، الطيبة",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src --ignore ./.data --ignore ./.data-e2e server/index.ts",
    "dev:once": "tsx server/index.ts",
    "start": "node --enable-source-maps dist-server/server/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only database \"vitest run --config vitest.rules.config.ts\"",
    "seed": "tsx scripts/seed/seed.ts",
    "seed:demo-samples": "tsx scripts/seed/demo-samples.ts",
    "republish": "tsx scripts/maintenance/republish.ts",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "@netlify/functions": "^6.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.28.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.52.0",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
