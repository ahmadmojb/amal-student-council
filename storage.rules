rules_version = '2';
// Only administrator-approved media uploaded by the server (Admin SDK, which
// bypasses these rules) lives under public-media/. Visitors may read it;
// nobody may write from a client.
service firebase.storage {
  match /b/{bucket}/o {
    match /public-media/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Daily schedule video (written by the server or via a server-issued signed URL).
    match /public-media/schedule-video/{file} {
      allow read: if resource.contentType in ['video/mp4', 'video/webm'];
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
