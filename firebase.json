{
  "database": { "rules": "database.rules.json" },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "run": { "serviceId": "amal-council", "region": "europe-west1" } }]
  },
  "emulators": {
    "database": { "port": 9000 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
